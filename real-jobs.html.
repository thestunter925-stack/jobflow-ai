<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<meta name="theme-color" content="#2563eb">
<title>JobFlow AI - Real Jobs</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:#f5f7fb;
  color:#111827;
}

header{
  background:#2563eb;
  color:#fff;
  padding:20px 15px;
}

.header{
  max-width:1100px;
  margin:auto;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
}

.logo{
  font-size:23px;
  font-weight:800;
}

.sub{
  font-size:13px;
  opacity:.9;
  margin-top:4px;
}

.container{
  max-width:1100px;
  margin:auto;
  padding:20px 15px 50px;
}

.card{
  background:#fff;
  border-radius:16px;
  padding:18px;
  margin-bottom:18px;
  box-shadow:0 4px 18px rgba(0,0,0,.06);
}

h2{
  margin-bottom:7px;
}

.muted{
  color:#64748b;
  font-size:14px;
  line-height:1.5;
}

.search-grid{
  display:grid;
  grid-template-columns:2fr 1fr 1fr;
  gap:10px;
  margin-top:15px;
}

input,
select{
  width:100%;
  padding:13px;
  border:1px solid #d1d5db;
  border-radius:9px;
  font:inherit;
  outline:none;
}

input:focus,
select:focus{
  border-color:#2563eb;
}

button{
  border:0;
  border-radius:9px;
  padding:12px 16px;
  font:inherit;
  font-weight:700;
  cursor:pointer;
}

.primary{
  background:#2563eb;
  color:#fff;
}

.secondary{
  background:#eaf0ff;
  color:#1d4ed8;
}

.search-btn{
  width:100%;
  margin-top:10px;
}

.status{
  display:none;
  margin-top:12px;
  padding:12px;
  border-radius:9px;
  background:#eff6ff;
  color:#1d4ed8;
  font-size:14px;
}

.status.show{
  display:block;
}

.job-list{
  display:grid;
  gap:14px;
}

.job{
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:15px;
  padding:17px;
}

.company{
  color:#2563eb;
  font-weight:700;
  margin-bottom:6px;
}

.title{
  font-size:18px;
  font-weight:800;
  margin-bottom:8px;
}

.location{
  color:#64748b;
  font-size:14px;
  margin-bottom:10px;
}

.tags{
  display:flex;
  flex-wrap:wrap;
  gap:6px;
  margin-bottom:13px;
}

.tag{
  background:#f1f5f9;
  border-radius:20px;
  padding:5px 9px;
  font-size:11px;
}

.actions{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
}

.empty{
  text-align:center;
  padding:35px 15px;
  color:#64748b;
}

.loading{
  text-align:center;
  padding:30px;
  color:#64748b;
}

.source{
  font-size:11px;
  color:#64748b;
  margin-top:10px;
}

@media(max-width:700px){
  .header{
    flex-direction:column;
    align-items:flex-start;
  }

  .search-grid{
    grid-template-columns:1fr;
  }

  .actions button{
    width:100%;
  }
}
</style>
</head>

<body>

<header>
  <div class="header">

    <div>
      <div class="logo">🚀 JobFlow AI</div>
      <div class="sub">Real Job Search</div>
    </div>

    <button
      class="secondary"
      type="button"
      id="backButton"
    >
      ← Dashboard
    </button>

  </div>
</header>


<main class="container">

  <section class="card">

    <h2>🔎 Search Real Jobs</h2>

    <p class="muted">
      Search currently published job listings from supported company
      career boards and live remote-job sources.
    </p>

    <div class="search-grid">

      <input
        id="keyword"
        type="text"
        placeholder="Job title or skill e.g. Software Engineer"
        autocomplete="off"
      >

      <input
        id="location"
        type="text"
        placeholder="Location e.g. India"
        autocomplete="off"
      >

      <select id="source">
        <option value="all">All Sources</option>
        <option value="greenhouse">Company Career Boards</option>
        <option value="remotive">Remote Jobs</option>
      </select>

    </div>

    <button
      id="searchButton"
      class="primary search-btn"
      type="button"
    >
      🔎 Search Jobs
    </button>

    <div
      id="status"
      class="status"
    ></div>

  </section>


  <section class="card">

    <h2>🏢 Companies & Live Sources</h2>

    <p class="muted">
      JobFlow checks supported public career-board feeds and displays
      the original application link.
    </p>

    <div
      id="companyList"
      style="
        display:flex;
        flex-wrap:wrap;
        gap:7px;
        margin-top:12px;
      "
    ></div>

  </section>


  <section>

    <div
      id="jobs"
      class="job-list"
    ></div>

  </section>

</main>


<script>
"use strict";


/*
==================================================
JOBFLOW AI REAL JOB SEARCH
==================================================

Greenhouse:
Public GET job-board data does not require
authentication.

Remotive:
Public remote-job API.

The page NEVER invents a job.
Every displayed job comes from a fetched source.

==================================================
*/


const GREENHOUSE_COMPANIES = [

  {
    name:"Airbnb",
    token:"airbnb"
  },

  {
    name:"Stripe",
    token:"stripe"
  },

  {
    name:"Cloudflare",
    token:"cloudflare"
  },

  {
    name:"Reddit",
    token:"reddit"
  },

  {
    name:"Datadog",
    token:"datadog"
  },

  {
    name:"Dropbox",
    token:"dropbox"
  },

  {
    name:"Figma",
    token:"figma"
  },

  {
    name:"GitLab",
    token:"gitlab"
  },

  {
    name:"HubSpot",
    token:"hubspot"
  },

  {
    name:"Okta",
    token:"okta"
  },

  {
    name:"Pinterest",
    token:"pinterest"
  },

  {
    name:"Shopify",
    token:"shopify"
  },

  {
    name:"Twilio",
    token:"twilio"
  },

  {
    name:"Uber",
    token:"uber"
  }

];


const keyword =
  document.getElementById("keyword");

const locationInput =
  document.getElementById("location");

const source =
  document.getElementById("source");

const searchButton =
  document.getElementById("searchButton");

const jobs =
  document.getElementById("jobs");

const status =
  document.getElementById("status");

const companyList =
  document.getElementById("companyList");


/*
==================================================
SHOW COMPANY NAMES
==================================================
*/

GREENHOUSE_COMPANIES.forEach(
  function(company){

    const span =
      document.createElement("span");

    span.className =
      "tag";

    span.textContent =
      company.name;

    companyList.appendChild(
      span
    );

  }
);


/*
==================================================
STATUS
==================================================
*/

function showStatus(
  text
){

  status.textContent =
    text;

  status.classList.add(
    "show"
  );

}


function hideStatus(){

  status.classList.remove(
    "show"
  );

}


/*
==================================================
ESCAPE HTML
==================================================
*/

function escapeHTML(
  value
){

  return String(value || "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");

}


/*
==================================================
GREENHOUSE
==================================================
*/

async function fetchGreenhouseCompany(
  company
){

  const endpoint =
    "https://boards-api.greenhouse.io/v1/boards/" +
    encodeURIComponent(
      company.token
    ) +
    "/jobs?content=true";


  try{

    const response =
      await fetch(
        endpoint,
        {
          method:"GET",
          cache:"no-store"
        }
      );


    if(!response.ok){

      throw new Error(
        "HTTP " +
        response.status
      );

    }


    const data =
      await response.json();


    if(
      !data ||
      !Array.isArray(
        data.jobs
      )
    ){

      return [];

    }


    return data.jobs.map(
      function(job){

        return {

          id:
            "gh-" +
            company.token +
            "-" +
            job.id,

          title:
            job.title ||
            "Job opportunity",

          company:
            company.name,

          location:
            job.location &&
            job.location.name
              ? job.location.name
              : "Location not specified",

          date:
            job.updated_at ||
            "",

          url:
            job.absolute_url ||
            "",

          source:
            "Official company career board",

          type:
            "Company job"

        };

      }
    );


  }catch(error){

    console.warn(
      "Could not load " +
      company.name,
      error
    );

    return [];

  }

}


/*
==================================================
REMOTIVE
==================================================
*/

async function fetchRemotive(){

  const url =
    "https://remotive.com/api/remote-jobs?limit=100";


  try{

    const response =
      await fetch(
        url,
        {
          method:"GET",
          cache:"no-store"
        }
      );


    if(!response.ok){

      throw new Error(
        "Remotive HTTP " +
        response.status
      );

    }


    const data =
      await response.json();


    if(
      !data ||
      !Array.isArray(
        data.jobs
      )
    ){

      return [];

    }


    return data.jobs.map(
      function(job){

        return {

          id:
            "remotive-" +
            job.id,

          title:
            job.title ||
            "Remote job",

          company:
            job.company_name ||
            "Company",

          location:
            job.candidate_required_location ||
            "Remote",

          date:
            job.publication_date ||
            "",

          url:
            job.url ||
            "",

          source:
            "Remotive",

          type:
            "Remote job"

        };

      }
    );


  }catch(error){

    console.warn(
      "Remotive unavailable",
      error
    );

    return [];

  }

}


/*
==================================================
SEARCH
==================================================
*/

async function searchJobs(){

  const term =
    keyword.value
      .trim()
      .toLowerCase();

  const place =
    locationInput.value
      .trim()
      .toLowerCase();

  const selectedSource =
    source.value;


  jobs.innerHTML =
    '<div class="loading">🔎 Searching real job sources...</div>';

  showStatus(
    "Connecting to live job feeds..."
  );


  let allJobs = [];


  /*
  ----------------------------------------------
  COMPANY CAREER BOARDS
  ----------------------------------------------
  */

  if(
    selectedSource === "all" ||
    selectedSource === "greenhouse"
  ){

    const companyResults =
      await Promise.all(
        GREENHOUSE_COMPANIES.map(
          fetchGreenhouseCompany
        )
      );


    companyResults.forEach(
      function(list){

        allJobs =
          allJobs.concat(
            list
          );

      }
    );

  }


  /*
  ----------------------------------------------
  REMOTIVE
  ----------------------------------------------
  */

  if(
    selectedSource === "all" ||
    selectedSource === "remotive"
  ){

    const remoteJobs =
      await fetchRemotive();


    allJobs =
      allJobs.concat(
        remoteJobs
      );

  }


  /*
  ----------------------------------------------
  FILTER
  ----------------------------------------------
  */

  let filtered =
    allJobs.filter(
      function(job){

        const text =
          (
            job.title +
            " " +
            job.company +
            " " +
            job.location
          ).toLowerCase();


        const keywordMatch =
          !term ||
          text.includes(
            term
          );


        const locationMatch =
          !place ||
          job.location
            .toLowerCase()
            .includes(
              place
            );


        return (
          keywordMatch &&
          locationMatch
        );

      }
    );


  /*
  ----------------------------------------------
  REMOVE DUPLICATES
  ----------------------------------------------
  */

  const seen =
    new Set();


  filtered =
    filtered.filter(
      function(job){

        const key =
          job.company +
          "|" +
          job.title +
          "|" +
          job.location;


        if(
          seen.has(key)
        ){

          return false;

        }


        seen.add(key);

        return true;

      }
    );


  /*
  ----------------------------------------------
  SORT
  ----------------------------------------------
  */

  filtered.sort(
    function(a,b){

      const first =
        Date.parse(
          a.date
        ) || 0;

      const second =
        Date.parse(
          b.date
        ) || 0;

      return second - first;

    }
  );


  renderJobs(
    filtered
  );


  showStatus(
    filtered.length +
    " real job listing(s) found."
  );

}


/*
==================================================
RENDER
==================================================
*/

function renderJobs(
  list
){

  jobs.innerHTML =
    "";


  if(!list.length){

    jobs.innerHTML =

      `
      <div class="card empty">

        <h3>
          No matching jobs found
        </h3>

        <p style="margin-top:8px">
          Try:
          "software engineer",
          "developer",
          "marketing",
          or leave the keyword blank.
        </p>

      </div>
      `;

    return;

  }


  list.forEach(
    function(job){

      const card =
        document.createElement(
          "article"
        );

      card.className =
        "job";


      const date =
        job.date
          ? new Date(
              job.date
            ).toLocaleDateString()
          : "Not specified";


      card.innerHTML =

        `
        <div class="company">

          🏢
          ${escapeHTML(
            job.company
          )}

        </div>


        <div class="title">

          ${escapeHTML(
            job.title
          )}

        </div>


        <div class="location">

          📍
          ${escapeHTML(
            job.location
          )}

        </div>


        <div class="tags">

          <span class="tag">
            ${escapeHTML(
              job.type
            )}
          </span>

          <span class="tag">
            Published/updated:
            ${escapeHTML(
              date
            )}
          </span>

        </div>


        <div class="actions">

          <button
            type="button"
            class="primary"
            data-apply="${encodeURIComponent(
              job.url
            )}"
          >
            Apply on Original Listing →
          </button>


          <button
            type="button"
            class="secondary"
            data-save="${encodeURIComponent(
              JSON.stringify(
                job
              )
            )}"
          >
            ⭐ Save Job
          </button>

        </div>


        <div class="source">

          Source:
          ${escapeHTML(
            job.source
          )}

        </div>
        `;


      jobs.appendChild(
        card
      );

    }
  );

}


/*
==================================================
RESULT BUTTONS
==================================================
*/

jobs.addEventListener(
  "click",
  function(event){

    const apply =
      event.target.closest(
        "[data-apply]"
      );


    if(apply){

      const url =
        decodeURIComponent(
          apply.getAttribute(
            "data-apply"
          )
        );


      if(!url){

        alert(
          "No application link is available."
        );

        return;

      }


      window.open(
        url,
        "_blank",
        "noopener,noreferrer"
      );

      return;

    }


    const save =
      event.target.closest(
        "[data-save]"
      );


    if(save){

      try{

        const job =
          JSON.parse(
            decodeURIComponent(
              save.getAttribute(
                "data-save"
              )
            )
          );


        let saved =
          JSON.parse(
            localStorage.getItem(
              "jobflow_saved_jobs"
            ) || "[]"
          );


        if(
          saved.some(
            function(item){

              return item.id ===
                job.id;

            }
          )
        ){

          save.textContent =
            "✓ Already Saved";

          return;

        }


        saved.push(
          job
        );


        localStorage.setItem(
          "jobflow_saved_jobs",
          JSON.stringify(
            saved
          )
        );


        save.textContent =
          "✓ Saved";

      }catch(error){

        alert(
          "Unable to save this job."
        );

      }

    }

  }
);


/*
==================================================
SEARCH BUTTON
==================================================
*/

searchButton.addEventListener(
  "click",
  searchJobs
);


/*
==================================================
ENTER KEY
==================================================
*/

keyword.addEventListener(
  "keydown",
  function(event){

    if(
      event.key ===
      "Enter"
    ){

      event.preventDefault();

      searchJobs();

    }

  }
);


locationInput.addEventListener(
  "keydown",
  function(event){

    if(
      event.key ===
      "Enter"
    ){

      event.preventDefault();

      searchJobs();

    }

  }
);


/*
==================================================
BACK
==================================================
*/

document
  .getElementById(
    "backButton"
  )
  .addEventListener(
    "click",
    function(){

      window.location.href =
        "JobFlow_AI_index.html";

    }
  );


/*
==================================================
INITIAL SEARCH
==================================================
*/

searchJobs();

</script>

</body>
</html>