  /* =======================================================
     INTERVIEW SCORE
     ======================================================= */

  function scoreInterviewAnswer() {

    const answer =
      document.getElementById(
        "interviewAnswer"
      );

    if (!answer) return;

    const text =
      answer.value.trim();

    if (!text) {

      toast(
        "Write your answer first."
      );

      return;

    }

    const words =
      text.split(/\s+/)
        .filter(Boolean)
        .length;

    let score = 40;

    if (words >= 30) score += 15;

    if (words >= 60) score += 15;

    if (words >= 100) score += 10;

    if (
      /\b(example|result|experience|learned|achieved)\b/i
        .test(text)
    ) {

      score += 10;

    }

    if (score > 100) {

      score = 100;

    }

    const result =
      document.getElementById(
        "interviewResults"
      );

    if (result) {

      result.innerHTML = `
        <h3>
          🎯 Interview Score
        </h3>

        <div
          style="
            font-size:42px;
            font-weight:800;
            margin-top:12px;
          ">
          ${score}/100
        </div>

        <p style="margin-top:10px">
          ${
            score >= 80
            ? "Excellent answer. Keep it focused and specific."
            : score >= 60
            ? "Good answer. Add a concrete example and measurable result."
            : "Try giving a structured answer with an example and result."
          }
        </p>
      `;

    }

    const history =
      getJSON(
        "interview_history",
        []
      );

    history.unshift({

      id: Date.now(),

      score: score,

      words: words,

      date:
        new Date()
          .toLocaleDateString()

    });

    setJSON(
      "interview_history",
      history.slice(0, 50)
    );

    toast(
      "Interview answer evaluated."
    );

  }


