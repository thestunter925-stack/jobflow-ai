======================================================= */

document.addEventListener(
  "keydown",
  function(event){

    /*
     * Ctrl + K = focus job search
     */

    if(
      event.ctrlKey &&
      event.key.toLowerCase() === "k"
    ){

      event.preventDefault();

      const search =
        document.getElementById(
          "jobQuery"
        );

      if(search){

        search.focus();

      }

    }

  }
);


