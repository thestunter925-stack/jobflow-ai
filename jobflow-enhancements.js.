  /* =======================================================
     JOB MATCH SCORE
     ======================================================= */

  function calculateMatchScore(
    jobText,
    skills
  ) {

    const text =
      String(jobText || "")
        .toLowerCase();

    const skillList =
      String(skills || "")
        .toLowerCase()
        .split(",")
        .map(function (item) {

          return item.trim();

        })
        .filter(Boolean);

    if (!skillList.length) {

      return 0;

    }

    let matches = 0;

    skillList.forEach(function (skill) {

      if (
        text.includes(skill)
      ) {

        matches++;

      }

    });

    return Math.round(
      (
        matches /
        skillList.length
      ) * 100
    );

  }


