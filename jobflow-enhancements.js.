/* =======================================================
   FREE TRIAL DISPLAY
======================================================= */

function updateTrialDisplay(){

  const elements =
    document.querySelectorAll(
      "[data-jobflow-trial]"
    );

  elements.forEach(function(element){

    if(isPremium()){

      element.textContent =
        "👑 Premium Member";

      return;

    }


    if(isTrialActive()){

      element.textContent =
        "⏱️ " +
        trialStatus();

    }else{

      element.textContent =
        "🔒 Trial Expired";

    }

  });

}


