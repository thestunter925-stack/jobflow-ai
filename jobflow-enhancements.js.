/* =======================================================
   APPLICATION FOLLOW-UP
======================================================= */

function addFollowUp(id){

  const apps =
    applications();

  const app =
    apps.find(function(item){

      return item.id === id;

    });

  if(!app){

    toast(
      "Application not found."
    );

    return;

  }


  const date =
    prompt(
      "Enter follow-up date (example: 28/08/2026):"
    );

  if(!date) return;


  app.followUp =
    date;

  saveApplications(
    apps
  );

  toast(
    "🔔 Follow-up saved."
  );


  if(
    typeof window.renderApplications ===
    "function"
  ){

    window.renderApplications();

  }

}


