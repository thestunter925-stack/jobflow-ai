function toggleDarkMode(){

  const enabled =
    localStorage.getItem(
      CONFIG.storagePrefix + "dark_mode"
    ) === "true";

  localStorage.setItem(
    CONFIG.storagePrefix + "dark_mode",
    String(!enabled)
  );

  applyDarkMode();

  toast(
    !enabled
      ? "🌙 Dark mode enabled."
      : "☀️ Light mode enabled."
  );

}


function applyDarkMode(){

  const enabled =
    localStorage.getItem(
      CONFIG.storagePrefix + "dark_mode"
    ) === "true";

  document.body.classList.toggle(
    "jobflow-dark",
    enabled
  );

}


/* =======================================================
   DATA EXPORT
======================================================= */

function exportData(){

  const data = {};

  for(
    let i = 0;
    i < localStorage.length;
    i++
  ){

    const key =
      localStorage.key(i);

    if(
      key &&
      key.startsWith(
        CONFIG.storagePrefix
      )
    ){

      data[key] =
        localStorage.getItem(key);

    }

  }

  const blob =
    new Blob(
      [
        JSON.stringify(
          data,
          null,
          2
        )
      ],
      {
        type:"application/json"
      }
    );

  const url =
    URL.createObjectURL(blob);

  const link =
    document.createElement("a");

  link.href = url;

  link.download =
    "JobFlow-AI-Backup.json";

  document.body.appendChild(link);

  link.click();

  document.body.removeChild(link);

  URL.revokeObjectURL(url);

  toast(
    "📦 JobFlow data exported."
  );

}


