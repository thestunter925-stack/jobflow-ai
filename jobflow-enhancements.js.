  /* =======================================================
     APPLICATION SEARCH
     ======================================================= */

  function filterApplications() {

    const input =
      document.getElementById(
        "applicationSearch"
      );

    if (!input) return;

    const query =
      input.value
        .toLowerCase()
        .trim();

    const list =
      applications();

    const filtered =
      list.filter(function (item) {

        return (
          String(
            item.company || ""
          )
          .toLowerCase()
          .includes(query) ||

          String(
            item.role || ""
          )
          .toLowerCase()
          .includes(query) ||

          String(
            item.status || ""
          )
          .toLowerCase()
          .includes(query)
        );

      });

    const container =
      document.getElementById(
        "applicationsList"
      );

    if (!container) return;

    if (!filtered.length) {

      container.innerHTML = `
        <div class="empty">
          🔎<br><br>
          No matching applications.
        </div>
      `;

      return;

    }

    container.innerHTML =
      filtered.map(function (app) {

        return `
          <div class="job">

            <div class="jobTop">

              <div>

                <h3>
                  ${safe(app.role)}
                </h3>

                <p>
                  🏢
                  ${safe(app.company)}
                </p>

                <p>
                  Applied:
                  ${safe(app.date)}
                </p>

              </div>

              <span class="badge">
                ${safe(app.status)}
              </span>

            </div>

            <div class="actions">

              ${
                app.url
                ? `
                  <a
                    class="btn primary"
                    href="${safe(app.url)}"
