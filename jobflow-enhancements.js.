  /* =======================================================
     SAFE STORAGE
     ======================================================= */

  function getJSON(key, fallback) {

    try {

      const value =
        localStorage.getItem(
          CONFIG.storagePrefix + key
        );

      return value
        ? JSON.parse(value)
        : fallback;

    } catch (error) {

      return fallback;

    }

  }


  function setJSON(key, value) {

    try {

      localStorage.setItem(
        CONFIG.storagePrefix + key,
        JSON.stringify(value)
      );

      return true;

    } catch (error) {

      return false;

    }

  }


  /* =======================================================
     TOAST
     ======================================================= */

  function toast(message) {

    if (
      typeof window.showToast ===
      "function"
    ) {

      window.showToast(message);
      return;

    }

    let box =
      document.getElementById(
        "jobflowEnhancementToast"
      );

    if (!box) {

      box =
        document.createElement("div");

      box.id =
        "jobflowEnhancementToast";

      box.style.cssText = `
        position:fixed;
        left:50%;
        bottom:25px;
        transform:translateX(-50%);
        background:#111827;
        color:white;
        padding:12px 18px;
        border-radius:12px;
        z-index:99999;
        font-size:14px;
        box-shadow:0 8px 30px rgba(0,0,0,.2);
      `;

      document.body.appendChild(box);

    }

    box.textContent = message;

    clearTimeout(
      box._timer
    );

    box._timer =
      setTimeout(function () {

        box.remove();

      }, 2500);

  }


  /* =======================================================
     ESCAPE HTML
     ======================================================= */

  function safe(value) {

    return String(value || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");

  }


  /* =======================================================
     48 HOUR TRIAL
     ======================================================= */

  function getTrialStart() {

    return Number(
      localStorage.getItem(
        CONFIG.storagePrefix +
        "trial_start"
      ) || 0
    );

  }


  function startTrial() {

    if (getTrialStart()) {

      if (isTrialActive()) {

        toast(
          "Your 48-hour free access is already active."
        );

        return;

      }

      toast(
        "Your free trial has expired."
      );

      return;

    }

    localStorage.setItem(
      CONFIG.storagePrefix +
      "trial_start",
      Date.now().toString()
    );

    toast(
      "🎉 Your 48-hour free access has started!"
    );

  }


  function isTrialActive() {

    const start =
      getTrialStart();

    if (!start) return false;

    const duration =
      CONFIG.trialHours *
      60 *
      60 *
      1000;

    return (
      Date.now() - start <
      duration
    );

  }


  function getTrialRemaining() {

    const start =
      getTrialStart();

    if (!start) return 0;

    const total =
      CONFIG.trialHours *
      60 *
      60 *
      1000;

    return Math.max(
      0,
      total - (Date.now() - start)
    );

  }


  function trialStatus() {

    const remaining =
      getTrialRemaining();

    if (!remaining) {

      return "Trial expired";

    }

    const hours =
      Math.floor(
        remaining /
        (60 * 60 * 1000)
      );

    const minutes =
      Math.floor(
        (remaining %
          (60 * 60 * 1000)) /
        (60 * 1000)
      );

    return (
      hours +
      "h " +
      minutes +
      "m remaining"
    );

  }


